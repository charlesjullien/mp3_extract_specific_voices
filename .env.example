# Jeton en lecture : https://huggingface.co/settings/tokens
# Il sert une seule fois à télécharger les poids du modèle de diarisation.
# L'audio n'est pas envoyé à Hugging Face.
HF_TOKEN=

# Modèle Whisper local. Décommentez une seule ligne.
# Les noms en .en sont anglais seulement : inutile pour du français.
# tiny        très rapide, transcription grossière
# base        rapide, convenable si l'audio est très clair
# small       bon compromis sur processeur (réglage de départ)
# medium      plus juste, environ 2 à 3 fois plus lent que small
# large-v3    le plus précis, lourd sur processeur
# large-v3-turbo  proche de large-v3, un peu plus rapide
WHISPER_MODEL=small

# Précision des voix.
# true  : vidéos courtes, répliques d'une à quelques secondes. Le programme
#         les sépare, puis recolle lui-même celles d'une même personne.
#         L'assemblage découpe davantage, donc dure plus longtemps.
# false : interviews longues, où chacun parle longtemps. Inutile d'affiner.
PRECISE=false

# Part des cœurs du processeur utilisée pour l'analyse et la transcription.
# 100 occupe tous les cœurs et va le plus vite. 70 laisse la machine utilisable.
# Un pourcentage ne bride pas Windows en continu : il fixe le nombre de fils de calcul.
CPU_PERCENT=100

# Taille maximale d'un fichier déposé, en mégaoctets.
MAX_UPLOAD_MB=500

PORT=8000

# Après un premier traitement complet (voix + transcription), le programme
# passe tout seul hors ligne pour les modèles si cette variable est absente.
# Forcer un nouveau téléchargement de modèles : HF_HUB_OFFLINE=0
# Interdire tout accès réseau aux modèles : HF_HUB_OFFLINE=1
